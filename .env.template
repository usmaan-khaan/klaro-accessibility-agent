# Secure Environment Variables for Accessibility Shield
# DO NOT COMMIT ACTUAL CREDENTIALS OR API KEYS

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ADK Agent Runtime Configuration
AGENT_RUNTIME_ID=projects/PROJECT_NUMBER/locations/LOCATION/reasoningEngines/ENGINE_ID

# Max self-heal attempts before the workflow gives up (default 3)
MAX_HEAL_ATTEMPTS=3

# Local testing or Gemini API configuration
# GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=True
LOGS_BUCKET_NAME=
